{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Active Feature List",
  "type": "object",
  "required": [
    "milestone",
    "updatedAt",
    "features"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "milestone": {
      "type": "string",
      "minLength": 1
    },
    "updatedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "dependencies",
          "acceptanceCriteria",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^feat-[0-9]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "enum": [
              "not-started",
              "in-progress",
              "blocked",
              "pass",
              "superseded"
            ]
          },
          "evidence": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
