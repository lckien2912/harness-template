# TanStack Start guard rules (on top of guard.node.rules). Format: kind|name|regex.

# Registry components (shadcn) pull third-party code into the repository.
ask|shadcn add|shadcn(-ui)?(@[^[:space:]]*)?[[:space:]]+add([[:space:]]|$)

# The route tree is generated by the router plugin from src/routes/.
block-path|routeTree.gen.ts|(^|/)routeTree\.gen\.ts$
# Build/SSR config and the global request middleware need a human.
ask-path|vite / app config|(^|/)(vite|app)\.config\.(ts|js|mts|mjs)$
ask-path|start entry (global middleware)|(^|/)src/(start|server|client)\.tsx?$
